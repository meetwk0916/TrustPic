{
  "sources": [
    {
      "name": "AIGC-Detection-Benchmark",
      "mode": "hf_rows",
      "enabled": false,
      "dataset": "TheKernel01/AIGC-Detection-Benchmark",
      "config": "default",
      "split": "test",
      "image_column": "image",
