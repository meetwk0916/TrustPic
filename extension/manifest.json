{
  "manifest_version": 3,
  "name": "TrustPic",
  "description": "Right-click an image to generate a TrustPic evidence report, analyzed locally in your browser.",
  "version": "0.1.0",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "TrustPic",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "service-worker.js"
  },
  "permissions": ["contextMenus", "sidePanel", "storage"],
  "host_permissions": ["<all_urls>"]
}
