{
  "manifest_version": 3,
  "name": "TrustPic",
  "description": "Analyze a single image with a TrustPic API and render the evidence report.",
  "version": "0.1.0",
  "action": {
    "default_title": "TrustPic"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "service-worker.js"
  },
  "permissions": ["contextMenus", "sidePanel", "storage"],
  "host_permissions": ["<all_urls>"]
}
